    {
      "type": "table",
      "title": "Estágios com falha ou pulados",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "stage_status != 1",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "keepLabels": [
              "scenario",
              "batch_id",
              "rule",
              "severity",
              "stage",
              "feature"
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "-1": {
                  "text": "pulado",
                  "color": "text",
                  "index": 0
                },
                "0": {
                  "text": "FALHOU",
                  "color": "red",
                  "index": 1
                }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
