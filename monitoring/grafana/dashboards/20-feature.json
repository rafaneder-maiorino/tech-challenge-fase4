{
  "uid": "cm-feature",
  "title": "Credit Monitor · Feature",
  "description": "Uma feature por vez: PSI, PSI ponderado e a participação dela no ganho do campeão lado a lado. O KS fica FORA do veredito de propósito — a etapa 2 mediu 21,5% de falso alarme sem correção; ele é diagnóstico e vive em reports/drift_tests/summary.md.",
  "tags": [
    "credit-monitor"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "scenario",
        "type": "custom",
        "label": "cenário",
        "query": "full,composition_only,stress_only",
        "current": {
          "text": "full",
          "value": "full"
        },
        "options": [
          {
            "text": "full",
            "value": "full",
            "selected": true
          },
          {
            "text": "composition_only",
            "value": "composition_only",
            "selected": false
          },
          {
            "text": "stress_only",
            "value": "stress_only",
            "selected": false
          }
        ]
      },
      {
        "name": "feature",
        "type": "query",
        "label": "feature",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(drift_psi, feature)",
          "refId": "A"
        },
        "refresh": 1,
        "current": {
          "text": "RevolvingUtilizationOfUnsecuredLines",
          "value": "RevolvingUtilizationOfUnsecuredLines"
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Credit Monitor",
      "tags": [
        "credit-monitor"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Participação no ganho do campeão",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(feature_gain_share{feature=\"$feature\"})",
          "legendFormat": "ganho",
          "instant": true,
          "range": false,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "orientation": "horizontal"
      }
    },
