{
  "uid": "cm-drilldown",
  "title": "Credit Monitor · Detalhe",
  "description": "Pipeline, drift, saúde do modelo e logs. Os meses sem rótulo aparecem AUSENTES nos painéis de saúde, não como zero: zero seria indistinguível de uma medição real.",
  "tags": [
    "credit-monitor"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "scenario",
        "type": "custom",
        "label": "cenário",
        "query": "full,composition_only,stress_only",
        "current": {
          "text": "full",
          "value": "full"
        },
        "options": [
          {
            "text": "full",
            "value": "full",
            "selected": true
          },
          {
            "text": "composition_only",
            "value": "composition_only",
            "selected": false
          },
          {
            "text": "stress_only",
            "value": "stress_only",
            "selected": false
          }
        ]
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Credit Monitor",
      "tags": [
        "credit-monitor"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Pipeline",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "barchart",
      "title": "Duração por estágio (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "stage_duration_seconds{scenario=\"$scenario\"}",
          "legendFormat": "{{batch_id}} · {{stage}}",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "keepLabels": [
              "batch_id",
              "scenario",
              "feature",
              "stage",
              "level"
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "batch_id"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "batch_id",
        "orientation": "vertical",
        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "barchart",
      "title": "Linhas em quarentena",
