{
  "uid": "cm-drilldown",
  "title": "Credit Monitor · Detalhe",
  "description": "Pipeline, drift, saúde do modelo e logs. Os meses sem rótulo aparecem AUSENTES nos painéis de saúde, não como zero: zero seria indistinguível de uma medição real.",
  "tags": [
    "credit-monitor"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "scenario",
        "type": "custom",
        "label": "cenário",
        "query": "full,composition_only,stress_only",
        "current": {
          "text": "full",
          "value": "full"
        },
        "options": [
          {
            "text": "full",
            "value": "full",
            "selected": true
          },
          {
            "text": "composition_only",
            "value": "composition_only",
            "selected": false
          },
          {
            "text": "stress_only",
            "value": "stress_only",
            "selected": false
          }
        ]
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Credit Monitor",
      "tags": [
        "credit-monitor"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Pipeline",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "barchart",
      "title": "Duração por estágio",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "stage_duration_seconds{scenario=\"$scenario\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "rowField": "batch_id",
            "columnField": "stage",
            "valueField": "Value",
            "emptyValue": "null"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "batch_id\\stage": "lote"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "lote"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": null,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "lote",
        "orientation": "vertical",
        "stacking": "none",
        "showValue": "never",
        "xTickLabelRotation": -45,
        "xTickLabelSpacing": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "barchart",
      "title": "Linhas em quarentena",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rows_quarantined{scenario=\"$scenario\"}",
          "legendFormat": "{{batch_id}}",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "keepLabels": [
              "batch_id",
              "scenario",
              "feature",
              "stage",
              "level"
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "batch_id"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": null,
          "decimals": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "batch_id",
        "orientation": "vertical",
        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": -45
      }
    },
    {
      "type": "table",
      "title": "Violações de contrato por regra e severidade",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "contract_violations{scenario=\"$scenario\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "keepLabels": [
              "scenario",
              "batch_id",
              "rule",
              "severity",
              "stage",
              "feature"
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "row",
      "title": "Drift",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "PSI por feature e mês (mapa de calor)",
      "description": "Verde < 0.10 ≤ laranja < 0.25 ≤ vermelho. Linhas ordenadas pelo PSI do mês 6: a feature que mais derivou fica no topo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 16,
        "h": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "drift_psi{scenario=\"$scenario\",batch_id=~\"month_.*\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "rowField": "feature",
            "columnField": "batch_id",
            "valueField": "Value",
            "emptyValue": "null"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "feature\\batch_id": "feature"
            },
            "indexByName": {
              "feature\\batch_id": 0,
              "month_00": 1,
              "month_01": 2,
              "month_02": 3,
              "month_03": 4,
              "month_04": 5,
              "month_05": 6,
              "month_06": 7
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          },
          "custom": {
            "align": "center",
            "minWidth": 60,
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "feature"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "custom.width",
                "value": 330
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "month_06",
            "desc": true
          }
        ]
      }
    },
    {
      "type": "barchart",
      "title": "PSI ponderado pelo ganho (o que importa)",
